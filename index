    <script>
        // --- State Management ---
        const DEFAULT_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxC1Q_KwgzgzDWUXk4ilFJOKOSDrg-gWiua-Xt_hUuqMVvQegSS4dytKUQc7iEMGA-9/exec";
        let consultas = JSON.parse(localStorage.getItem('consultasData')) || [];
        let remoteData = []; 
        const SECURITY_PIN = "9326";
        let currentSort = { col: 'timestamp', asc: false };

        // --- DOM Elements ---
        const navForm = document.getElementById('nav-form');
        const navDashboard = document.getElementById('nav-dashboard');
        const sectionForm = document.getElementById('section-form');
        const sectionDashboard = document.getElementById('section-dashboard');
        
        const form = document.getElementById('consulta-form');
        const scriptUrlInput = document.getElementById('script-url');
        const timeDisplay = document.getElementById('current-time-display');
        const timestampInput = document.getElementById('timestamp');
        const submitBtn = document.getElementById('submit-btn');
        const btnText = document.getElementById('btn-text');
        const btnSpinner = document.getElementById('btn-spinner');
        
        const inputPersonal = document.getElementById('personal_nombre');
        const inputDelegacion = document.getElementById('delegacion');

        const tableBody = document.getElementById('table-body');
        const searchInput = document.getElementById('search-input');
        const clearBtn = document.getElementById('clear-data-btn');
        const toast = document.getElementById('toast');
        const toastMessage = document.getElementById('toast-message');

        // --- Clock Update ---
        function updateClock() {
            const now = new Date();
            const formatted = now.toLocaleString('es-AR', { 
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit'
            });
            timeDisplay.textContent = formatted;
            timestampInput.value = now.toISOString();
        }
        setInterval(updateClock, 1000);
        updateClock();

        // --- Navigation ---
        function showSection(section) {
            if (section === 'form') {
                sectionForm.classList.remove('hidden');
                sectionDashboard.classList.add('hidden');
                navForm.classList.add('bg-blue-800');
                navDashboard.classList.remove('bg-blue-800');
            } else {
                sectionForm.classList.add('hidden');
                sectionDashboard.classList.remove('hidden');
                navDashboard.classList.add('bg-blue-800');
                navForm.classList.remove('bg-blue-800');
                
                if(scriptUrlInput.value.trim() && remoteData.length === 0) {
                    syncData();
                } else {
                    applyFilters();
                }
            }
        }

        navForm.addEventListener('click', () => showSection('form'));
        navDashboard.addEventListener('click', () => showSection('dashboard'));

        // --- STREAMING_CHUNK:Implementing PIN & Config Logic... ---
        // --- PIN & Config Logic ---
        function openPinModal() {
            document.getElementById('pin-modal').classList.remove('hidden');
            document.getElementById('pin-input').value = '';
            document.getElementById('pin-error').classList.add('hidden');
            setTimeout(() => document.getElementById('pin-input').focus(), 100);
        }

        function closePinModal() {
            document.getElementById('pin-modal').classList.add('hidden');
        }

        function verifyPin() {
            const pin = document.getElementById('pin-input').value;
            if (pin === SECURITY_PIN) {
                closePinModal();
                document.getElementById('script-config-section').classList.remove('hidden');
            } else {
                document.getElementById('pin-error').classList.remove('hidden');
            }
        }

        function closeScriptConfig() {
            document.getElementById('script-config-section').classList.add('hidden');
        }

        // Allow pressing Enter on PIN input
        document.getElementById('pin-input').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') verifyPin();
        });

        // --- Load saved Settings ---
        const savedUrl = localStorage.getItem('scriptUrl');
        if (savedUrl) {
            scriptUrlInput.value = savedUrl;
        } else {
            scriptUrlInput.value = DEFAULT_SCRIPT_URL; // Default URL provided
        }

        scriptUrlInput.addEventListener('change', (e) => {
            localStorage.setItem('scriptUrl', e.target.value);
        });

        inputPersonal.value = localStorage.getItem('personal_nombre') || '';
        inputDelegacion.value = localStorage.getItem('delegacion') || '';

        inputPersonal.addEventListener('change', (e) => localStorage.setItem('personal_nombre', e.target.value));
        inputDelegacion.addEventListener('change', (e) => localStorage.setItem('delegacion', e.target.value));

        // --- STREAMING_CHUNK:Handling Form Submissions... ---
        // --- Form Submission ---
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            submitBtn.disabled = true;
            btnText.textContent = 'Guardando...';
            btnSpinner.classList.remove('hidden');

            const formData = new FormData(form);
            const dataObj = {};
            formData.forEach((value, key) => {
                dataObj[key] = value;
            });
            
            const localDate = new Date(dataObj.timestamp);
            dataObj.displayTime = localDate.toLocaleString('es-AR');

            try {
                const url = scriptUrlInput.value.trim();
                if (url) {
                    await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                        body: JSON.stringify(dataObj)
                    });
                    remoteData.unshift(dataObj);
                    populateFilterOptions();
                }

                saveLocal(dataObj);
                showToast("Consulta guardada exitosamente", "success");
                
                // Preserve sticky fields and Script URL
                const tempPersonal = inputPersonal.value;
                const tempDelegacion = inputDelegacion.value;
                const tempScriptUrl = scriptUrlInput.value;
                
                form.reset();
                
                inputPersonal.value = tempPersonal;
                inputDelegacion.value = tempDelegacion;
                scriptUrlInput.value = tempScriptUrl;
                
                updateClock();

            } catch (error) {
                console.error('Error:', error);
                showToast("Error de conexión. Se guardó localmente.", "error");
                saveLocal(dataObj);
            } finally {
                submitBtn.disabled = false;
                btnText.textContent = 'Guardar Consulta';
                btnSpinner.classList.add('hidden');
            }
        });

        function saveLocal(data) {
            consultas.unshift(data);
            localStorage.setItem('consultasData', JSON.stringify(consultas));
            if(!sectionDashboard.classList.contains('hidden')) {
                applyFilters();
            }
        }

        // --- STREAMING_CHUNK:Building Analytics & Table Rendering... ---
        // --- Sorting Logic ---
        function toggleSort(col) {
            if (currentSort.col === col) {
                currentSort.asc = !currentSort.asc;
            } else {
                currentSort.col = col;
                currentSort.asc = true;
            }
            updateSortIcons();
            applyFilters();
        }

        function updateSortIcons() {
            const cols = ['timestamp', 'agente', 'tema'];
            cols.forEach(c => {
                const icon = document.getElementById(`sort-icon-${c}`);
                if (icon) {
                    icon.className = 'fas ml-1 text-gray-400 ';
                    if (currentSort.col === c) {
                        icon.className += currentSort.asc ? 'fa-sort-up text-blue-900' : 'fa-sort-down text-blue-900';
                    } else {
                        icon.className += 'fa-sort';
                    }
                }
            });
        }

        // --- Fetch & Dashboard Logic ---
        async function syncData() {
            const url = scriptUrlInput.value.trim();
            if (!url) {
                showToast("URL de script no configurada", "error");
                return;
            }
            
            const syncIcon = document.getElementById('sync-icon');
            syncIcon.classList.add('fa-spin');
            
            try {
                const response = await fetch(url);
                const data = await response.json();
                
                if(data.error) {
                    console.error("Script error:", data.error);
                    showToast("Error al obtener datos", "error");
                } else {
                    remoteData = data.reverse(); 
                    showToast("Datos sincronizados con Sheets", "success");
                }
            } catch (error) {
                console.error('Fetch error:', error);
                showToast("No se pudo conectar a Sheets. Mostrando datos locales.", "error");
            } finally {
                syncIcon.classList.remove('fa-spin');
                populateFilterOptions();
                applyFilters();
            }
        }

        function populateFilterOptions() {
            const dataSource = remoteData.length > 0 ? remoteData : consultas;
            const delSelect = document.getElementById('filter-delegacion');
            const agentSelect = document.getElementById('filter-agente');
            const currentDel = delSelect.value;
            const currentAgent = agentSelect.value;
            
            const delegations = [...new Set(dataSource.map(item => item.delegacion).filter(Boolean))].sort();
            const agents = [...new Set(dataSource.map(item => item.personal_nombre).filter(Boolean))].sort();
            
            delSelect.innerHTML = '<option value="all">Todas</option>' + delegations.map(d => `<option value="${d}">${d}</option>`).join('');
            delSelect.value = delegations.includes(currentDel) ? currentDel : 'all';
            
            agentSelect.innerHTML = '<option value="all">Todos</option>' + agents.map(a => `<option value="${a}">${a}</option>`).join('');
            agentSelect.value = agents.includes(currentAgent) ? currentAgent : 'all';
        }

        function applyFilters() {
            const dateFilter = document.getElementById('filter-date').value;
            const delFilter = document.getElementById('filter-delegacion').value;
            const agentFilter = document.getElementById('filter-agente').value;
            const searchTerm = document.getElementById('search-input').value.toLowerCase();
            
            const dataSource = remoteData.length > 0 ? remoteData : consultas;
            const now = new Date();
            const startOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
            
            let filteredData = dataSource.filter(item => {
                if (searchTerm) {
                    const matchSearch = (item.tema && item.tema.toLowerCase().includes(searchTerm)) ||
                                        (item.nombre && item.nombre.toLowerCase().includes(searchTerm)) ||
                                        (item.documento && String(item.documento).toLowerCase().includes(searchTerm)) ||
                                        (item.descripcion && item.descripcion.toLowerCase().includes(searchTerm));
                    if (!matchSearch) return false;
                }
                if (delFilter !== 'all' && item.delegacion !== delFilter) return false;
                if (agentFilter !== 'all' && item.personal_nombre !== agentFilter) return false;
                
                if (dateFilter !== 'all') {
                    if (!item.timestamp) return false;
                    const itemDate = new Date(item.timestamp);
                    if (dateFilter === 'today' && itemDate < startOfDay) return false;
                    if (dateFilter === 'month' && itemDate < startOfMonth) return false;
                }
                return true;
            });

            // Ordenamiento de tabla (Sorting)
            filteredData.sort((a, b) => {
                let valA, valB;
                if (currentSort.col === 'timestamp') {
                    valA = new Date(a.timestamp || 0).getTime();
                    valB = new Date(b.timestamp || 0).getTime();
                } else if (currentSort.col === 'agente') {
                    valA = (a.personal_nombre || '').toLowerCase();
                    valB = (b.personal_nombre || '').toLowerCase();
                } else if (currentSort.col === 'tema') {
                    valA = (a.tema || '').toLowerCase();
                    valB = (b.tema || '').toLowerCase();
                }
                
                if (valA < valB) return currentSort.asc ? -1 : 1;
                if (valA > valB) return currentSort.asc ? 1 : -1;
                return 0;
            });

            renderTable(filteredData);
            updateStats(filteredData);
            updateSortIcons();
        }

        function renderTable(data) {
            if (data.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="6" class="px-4 py-4 text-center text-sm text-gray-500">No hay datos registrados o que coincidan con los filtros.</td></tr>`;
                return;
            }
            
            tableBody.innerHTML = data.map(item => {
                let dateDisplay = '-';
                if(item.timestamp) {
                    const d = new Date(item.timestamp);
                    if(!isNaN(d.getTime())) {
                        dateDisplay = d.toLocaleString('es-AR');
                    } else {
                        dateDisplay = item.timestamp; 
                    }
                }

                // Limpiamos espacios laterales y vacíos para la descripción
                const descText = item.descripcion ? item.descripcion.trim() : '-';

                return `
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">${dateDisplay}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                        <span class="font-bold text-blue-900">${item.personal_nombre || '-'}</span><br>
                        <span class="text-xs text-gray-500">${item.delegacion || '-'}</span>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap">
                        <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-900 border border-blue-200">
                            ${item.tema || '-'}
                        </span>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                        ${item.nombre || '<span class="text-gray-400 italic">Anónimo</span>'}<br>
                        ${item.documento ? `<span class="text-xs text-gray-500 font-mono">DNI: ${item.documento}</span>` : ''}
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">
                        ${item.telefono ? `<i class="fas fa-phone text-xs w-4"></i> ${item.telefono}<br>` : ''}
                        ${item.email ? `<i class="fas fa-envelope text-xs w-4"></i> ${item.email}` : ''}
                        ${!item.telefono && !item.email ? '-' : ''}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-600 w-full min-w-[250px] whitespace-pre-wrap break-words">${descText}</td>
                </tr>
            `}).join('');
        }

        function updateStats(filteredData) {
            document.getElementById('stat-total').textContent = filteredData.length;
            
            const today = new Date().toDateString();
            const todayCount = filteredData.filter(c => {
                if(!c.timestamp) return false;
                const d = new Date(c.timestamp);
                return !isNaN(d.getTime()) && d.toDateString() === today;
            }).length;
            document.getElementById('stat-today').textContent = todayCount;

            const subsidiosCount = filteredData.filter(c => c.tema && c.tema.includes('Subsidios')).length;
            document.getElementById('stat-subsidios').textContent = subsidiosCount;

            if (filteredData.length > 0) {
                const counts = {};
                filteredData.forEach(c => {
                    const temaKey = c.tema || 'Sin tema';
                    counts[temaKey] = (counts[temaKey] || 0) + 1;
                });
                const topTema = Object.keys(counts).reduce((a, b) => counts[a] > counts[b] ? a : b);
                document.getElementById('stat-top-tema').textContent = `${topTema} (${counts[topTema]})`;
            } else {
                document.getElementById('stat-top-tema').textContent = '-';
            }
        }

        // --- Event Listeners ---
        document.getElementById('filter-date').addEventListener('change', applyFilters);
        document.getElementById('filter-delegacion').addEventListener('change', applyFilters);
        document.getElementById('filter-agente').addEventListener('change', applyFilters);
        searchInput.addEventListener('input', applyFilters);

        clearBtn.addEventListener('click', () => {
            if(confirm('¿Estás seguro de que deseas borrar todos los registros locales? (No borrará la nube)')) {
                consultas = [];
                localStorage.removeItem('consultasData');
                if (remoteData.length === 0) applyFilters();
                showToast("Datos locales borrados", "success");
            }
        });

        // --- Utilities ---
        function showToast(message, type = "success") {
            toastMessage.textContent = message;
            if (type === "error") {
                toast.classList.replace('bg-green-600', 'bg-red-600');
                toast.querySelector('i').classList.replace('fa-check-circle', 'fa-exclamation-circle');
            } else {
                toast.classList.replace('bg-red-600', 'bg-green-600');
                toast.querySelector('i').classList.replace('fa-exclamation-circle', 'fa-check-circle');
            }
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }

        function copyCode() {
            const codeText = document.getElementById('script-code').innerText;
            const tempTextArea = document.createElement('textarea');
            tempTextArea.value = codeText;
            document.body.appendChild(tempTextArea);
            tempTextArea.select();
            try {
                document.execCommand('copy');
                showToast("Código copiado al portapapeles", "success");
            } catch (err) {
                console.error('Failed to copy', err);
                showToast("Error al copiar", "error");
            } finally {
                document.body.removeChild(tempTextArea);
            }
        }
    </script>
</body>
</html>
